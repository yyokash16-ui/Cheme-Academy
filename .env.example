# Copy to .env.local. Use only Supabase URL and publishable key in browser code.
# Leave blank to use clearly-labelled demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only (configure in Vercel Project Settings; never use a VITE_ prefix).
DATABASE_URL=your_Neon_Postgres_connection_string
OWNER_EMAIL=your_verified_owner_email
